# Variables à renseigner dans le tableau de bord Railway / Render.
# Ne jamais committer un .env réel avec de vraies valeurs.

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=                      # générer une valeur aléatoire longue (ex: python -c "import secrets; print(secrets.token_urlsafe(50))")
DEBUG=False

# Fournie automatiquement par Railway/Render si la base est liée au service.
DATABASE_URL=

# Fournie automatiquement si Redis est lié au service (sinon, cf README pour
# une alternative sans Celery pour une démo minimale).
REDIS_URL=

TMDB_API_KEY=

# Domaine du frontend déployé sur Vercel, sans slash final.
CORS_ORIGINS=https://ton-projet.vercel.app
CSRF_TRUSTED_ORIGINS=https://ton-projet.vercel.app

# Optionnel : restreindre explicitement les hôtes autorisés une fois le
# domaine backend connu (Railway/Render l'ajoutent automatiquement sinon).
ALLOWED_HOSTS=
